{
  "name": "oshi-tabi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "secretlint": "secretlint \"**/*\"",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "pre-merge-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": "secretlint"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "secretlint": "^13.1.0",
    "simple-git-hooks": "^2.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
